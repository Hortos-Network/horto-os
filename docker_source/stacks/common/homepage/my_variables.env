# This is the environment file for the DGI-OS setup with IOT LAN.
# Only one of the two .env files should be present on /srv/active_setup.
# Those Variables get copied to active_setup used by setup scripts
MY_HOSTNAME="DGI-OS_xxx"
# Read in the docs, how to get the WIFI_INTERFACE name
WIFI_INTERFACE="wlx00xxxxxx"
WIFI_SSID="DGI-IoT-LAN"
WIFI_PASSPHRASE=""
# Public URL and token used by cloudflared for instance
MY_URL="YourDomainName.net"
MY_CLOUDFLARE_TOKEN=""
